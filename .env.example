# ==============================================================================
# LEÓN PROVEEDORES - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE (Vite Public Variables - Safe for browser bundle)
# ------------------------------------------------------------------------------
# URL of your Supabase Project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Publishable / Anon Key (Used by client to connect to Supabase)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE / SUPABASE SECRETS (NEVER expose to frontend or git)
# Configured via: supabase secrets set <KEY>=<VALUE>
# ------------------------------------------------------------------------------
# OpenAI Secret API Key (Used by extract-invoice Edge Function)
# OPENAI_API_KEY=sk-...

# OpenAI Document Model to use for extraction (Default: gpt-4o-mini)
# OPENAI_DOCUMENT_MODEL=gpt-4o-mini
